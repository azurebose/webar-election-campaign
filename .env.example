# ==============================================================================
# Cloudflare R2 Storage (Zero-Egress Large Asset Hosting & Admin Ingestion)
# ==============================================================================
# Cloudflare Account ID (find in Cloudflare dashboard -> R2 overview)
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id

# Cloudflare R2 S3-Compatible API Credentials
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=election-campaign-assets

# Public CDN domain for R2 bucket (e.g., assets.electioncampaign.org or pub-xxx.r2.dev)
NEXT_PUBLIC_R2_PUBLIC_DOMAIN=assets.electioncampaign.org

# Authorized Admin Email strictly permitted to upload targets.mind and campaign video assets
ADMIN_EMAIL=admin@electioncampaign.org

# ==============================================================================
# Firebase Client Configuration (Passwordless Auth & Firestore Quota / Pledges)
# ==============================================================================
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyExampleKey1234567890
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=election-webar.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=election-webar
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=election-webar.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789012
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789012:web:abcdef123456

# ==============================================================================
# Legacy / Optional Fallback Credentials
# ==============================================================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
